# ============================================================
# 个人门户 - 环境变量模板
# 复制为 .env 并填入实际值, .env 已加入 .gitignore
# ============================================================

# === Database ===
# 本地开发用 SQLite, 生产可切到 Postgres (推荐 Docker 部署)
DATABASE_URL="file:./prisma/dev.db"
# 生产 Postgres 示例: postgresql://user:password@host:5432/portal?schema=public

# === NextAuth.js ===
# 生成密钥: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-string"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# === App ===
NEXT_PUBLIC_APP_NAME="我的导航"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# === Optional: OAuth Providers ===
# GITHUB_ID=""
# GITHUB_SECRET=""
# GOOGLE_ID=""
# GOOGLE_SECRET=""

# === Optional: Email (SMTP) ===
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT=""
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM=""

# === Logging ===
LOG_LEVEL="info"

# === 经期预测 (Flask 微服务) ===
# 本地开发: Flask 跑在 127.0.0.1:5001
# Docker 部署: 用服务名 http://period-flask:5001
PERIOD_API_URL="http://127.0.0.1:5001"
# 与 Flask 共享的 HMAC 密钥 (openssl rand -hex 32)
# 必须与 period-tracker 项目的 PERIOD_SERVICE_SECRET 完全一致
PERIOD_SERVICE_SECRET=""

# === 云盘 (pan.xujianfei.cn) ===
# local (ECS 本地盘) 或 oss (aliyun OSS)
STORAGE_DRIVER="local"
# local 驱动根目录. ECS 生产: /www/pan_data (next-server 用 www 用户跑, 需 chown)
# 本地 dev: 留空使用 ./storage (相对项目根)
STORAGE_ROOT=""

# === aliyun OSS (STORAGE_DRIVER=oss 时必填) ===
# OSS_REGION="oss-cn-hangzhou"
# OSS_BUCKET="my-pan-files"
# OSS_ACCESS_KEY_ID=""
# OSS_ACCESS_KEY_SECRET=""
# ECS 与 bucket 同区时设 'true', 走内网 (免流量费 + 更快)
# OSS_INTERNAL="true"
# 自定义 endpoint (一般用不到, 留空)
# OSS_ENDPOINT=""

{
  "name": "personal-portal",
  "version": "0.1.0",
  "private": true,
  "description": "个人门户与导航中心 - Next.js 15 全栈方案",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
